# Unsloth Stack Configuration
# Copy this file to .env and adjust values

# Caddy Security User Management
# These variables are used to create the initial admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
ADMIN_EMAIL=admin@your-domain.com

# JWT Secret for token signing
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# Local IP address of the machine running Unsloth Studio
STUDIO_HOST=192.168.x.x

# Port Unsloth Studio listens on
STUDIO_PORT=8000

# Public domain pointing to this machine (must have DNS configured)
DOMAIN=your-domain.com

# Optional: SMTP configuration for password reset
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=admin@your-domain.com
