{
    admin off
}

{$DOMAIN} {
    reverse_proxy {$STUDIO_HOST}:{$STUDIO_PORT} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

:80 {
    redir https://{$DOMAIN}{uri}
}
